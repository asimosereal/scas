# Neon / PostgreSQL connection string.
# Create a project at https://console.neon.tech, then copy the connection string.
#
# The prototype runs without this variable — it falls back to the seeded
# in-memory snapshot described in TECHNICAL_SUMMARY.md section I.
#
# Apply the schema and seed:
#   psql "$DATABASE_URL" -f db/schema.sql
#   psql "$DATABASE_URL" -f db/seed.sql
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
